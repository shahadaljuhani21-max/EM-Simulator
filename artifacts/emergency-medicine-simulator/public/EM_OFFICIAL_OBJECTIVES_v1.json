  "courseOutcomes": [
    {
      "id": "EMED615-CLO-1-1",
      "text": "To explain the pathophysiology and presentation of life/organ-threatening diseases."
    },
    {
      "id": "EMED615-CLO-1-2",
      "text": "To develop a general approach to medical and surgical emergencies."
    },
    {
      "id": "EMED615-CLO-1-3",
      "text": "To analyze common emergency situations and demonstrate how to manage them."
    },
    {
      "id": "EMED615-CLO-2-1",
      "text": "Demonstrates behavior that conveys caring, honesty, genuine interest, and tolerance when interacting with a diverse population."
    },
    {
      "id": "EMED615-CLO-2-2",
      "text": "Demonstrates behavior that conveys punctuality with acknowledgment of the value of time and conveys professional behavior in the emergency department."
    },
    {
      "id": "EMED615-CLO-3-1",
      "text": "To organize a general approach to medical and surgical emergencies"
    },
    {
      "id": "EMED615-CLO-3-2",
      "text": "To perform common emergency procedures."
    }
  ],
